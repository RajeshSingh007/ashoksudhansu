---
import Container from '../common/Container.astro';
import Eyebrow from '../common/Eyebrow.astro';
import { site, nav, social, contactCta } from '../../config/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="panel panel--stacked scroll-mt-24 bg-snow">
  <Container class="pt-16 pb-12">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Eyebrow>Get in touch</Eyebrow>
        <h2
          class="mt-3 max-w-md text-[26px] font-semibold leading-[1.2] tracking-[-0.02em] text-obsidian sm:text-[30px]"
        >
          Have an idea worth carrying forward, or need help resolving a conflict?
        </h2>
        <a
          href={contactCta.href}
          class="mt-5 inline-flex items-center rounded-[14px] border border-[#2c2e34] bg-obsidian px-5 py-3 text-[15px] font-medium text-snow transition-colors hover:bg-graphite"
        >
          {site.email}
        </a>
      </div>

      <nav aria-label="Footer">
        <Eyebrow>Explore</Eyebrow>
        <ul class="mt-4 space-y-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[15px] text-graphite transition-colors hover:text-obsidian"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Social">
        <Eyebrow>Elsewhere</Eyebrow>
        <ul class="mt-4 space-y-3">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[15px] text-graphite transition-colors hover:text-obsidian"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>

  <div class="border-t border-cloud">
    <Container>
      <div
        class="flex flex-col gap-2 py-6 text-[13px] text-fog sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} {site.fullName}. All rights reserved.</p>
        <p>{site.role}</p>
      </div>
    </Container>
  </div>
</footer>
