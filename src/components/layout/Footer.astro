---
import Container from '../common/Container.astro';
import Eyebrow from '../common/Eyebrow.astro';
import { site, nav, social, contactCta } from '../../config/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="panel panel--stacked scroll-mt-24 overflow-hidden bg-snow">
  <Container class="pt-16 pb-14 sm:pt-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Eyebrow>Get in touch</Eyebrow>
        <h2
          class="mt-3 max-w-md text-[26px] font-semibold leading-[1.2] tracking-[-0.02em] text-obsidian sm:text-[30px]"
        >
          Have an idea worth carrying forward, or looking for the right direction from someone who understands <span class="underline decoration-ember decoration-2 underline-offset-[4px]">YOUR</span> Problem.
        </h2>
        <a
          href={contactCta.href}
          class="group mt-6 inline-flex items-center gap-2.5 rounded-[14px] border border-[#2c2e34] bg-obsidian px-5 py-3 text-[15px] font-medium text-snow transition-colors hover:bg-graphite"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          {site.email}
          <span
            aria-hidden="true"
            class="text-ember transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      </div>

      <nav aria-label="Footer">
        <Eyebrow>Explore</Eyebrow>
        <ul class="mt-4 space-y-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group inline-flex items-center text-[15px] text-graphite transition-colors hover:text-obsidian"
                >
                  <span
                    aria-hidden="true"
                    class="inline-block max-w-0 overflow-hidden text-ember opacity-0 transition-all duration-300 group-hover:mr-2 group-hover:max-w-[1.25rem] group-hover:opacity-100"
                  >
                    →
                  </span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Social">
        <Eyebrow>Elsewhere</Eyebrow>
        <ul class="mt-4 space-y-3">
          {
            social.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group inline-flex items-center text-[15px] text-graphite transition-colors hover:text-obsidian"
                >
                  <span
                    aria-hidden="true"
                    class="inline-block max-w-0 overflow-hidden text-ember opacity-0 transition-all duration-300 group-hover:mr-2 group-hover:max-w-[1.25rem] group-hover:opacity-100"
                  >
                    →
                  </span>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </Container>

  {/* Oversized wordmark — a quiet signature bleeding across the base. */}
  <div aria-hidden="true" class="pointer-events-none select-none px-4">
    <p
      class="whitespace-nowrap text-center text-[clamp(2rem,12vw,13rem)] font-semibold leading-[0.8] tracking-[-0.045em] text-obsidian/[0.055]"
    >
      {site.fullName}
    </p>
  </div>

  <div class="border-t border-cloud">
    <Container>
      <div
        class="flex flex-col gap-2 py-6 text-[13px] text-fog sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} {site.fullName}. All rights reserved.</p>
        <div class="flex items-center gap-3">
          <span>{site.role}</span>
          <span aria-hidden="true">·</span>
          <a href="/admin/" class="transition-colors hover:text-obsidian">Author</a>
        </div>
      </div>
    </Container>
  </div>
</footer>
