---
import { getImage as resolveImage } from 'astro:assets';
import Section from '../common/Section.astro';
import ReviewBoard from './ReviewBoard.tsx';
import { getImage } from '../../lib/images';
import { reviewsSection, featuredImage } from '../../config/reviews';

// Resolve the featured-slot image to an optimized URL for the island
// (React can't use astro:assets <Image> directly).
let imageSrc: string | undefined;
const meta = getImage(featuredImage);
if (meta) {
  imageSrc = (await resolveImage({ src: meta, width: 800 })).src;
}
---

<Section
  id="reviews"
  space="none"
  class="pt-16 pb-20 sm:pt-16 sm:pb-20"
>
  <header class="mb-10 max-w-3xl sm:mb-12">
    <p class="eyebrow flex items-center gap-2.5 text-ember">
      <span class="h-px w-7 bg-ember" aria-hidden="true"></span>
      {reviewsSection.eyebrow}
    </p>
    <h2 class="mt-3 text-[32px] font-semibold leading-[1.08] tracking-[-0.03em] text-obsidian sm:text-[44px]">
      Hear directly from the people who were{' '}
      <span class="italic font-normal underline decoration-ember decoration-2 underline-offset-[6px]">
        inspired
      </span>{' '}
      along the way.
    </h2>
  </header>
  <ReviewBoard client:visible imageSrc={imageSrc} />
</Section>
