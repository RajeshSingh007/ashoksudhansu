---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import Eyebrow from '../components/common/Eyebrow.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <Container class="flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <Eyebrow>Error 404</Eyebrow>
    <h1 class="mt-4 text-[48px] font-semibold tracking-[-0.03em] text-obsidian sm:text-[64px]">
      Lost the thread
    </h1>
    <p class="mt-4 max-w-md text-[17px] leading-relaxed text-steel">
      The page you were looking for isn't here. Let's get you back to something worth reading.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/" variant="primary" size="lg">Back home</Button>
      <Button href="/ideas" variant="ghost" size="lg">Browse thoughts</Button>
    </div>
  </Container>
</BaseLayout>
