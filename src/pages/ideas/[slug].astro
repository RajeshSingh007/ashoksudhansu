---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import LikeButton from '../../components/ideas/LikeButton.tsx';
import { supabase } from '../../lib/supabase';
import { formatDate } from '../../lib/format';
import { parseBody, readingMinutes } from '../../lib/thoughtBody';

const { slug } = Astro.params;

const { data: thought } = await supabase
  .from('thoughts')
  .select('*')
  .eq('slug', slug)
  .maybeSingle();

if (!thought) {
  return Astro.redirect('/ideas/');
}

const blocks = parseBody(thought.body);
const firstPara = blocks.findIndex((b) => b.type === 'p');
const minutes = readingMinutes(thought.body);
---

<BaseLayout title={`${thought.title} — Thoughts`} description={thought.description}>
  <Container class="pt-16 pb-24 sm:pt-20 sm:pb-28">
    <div class="mx-auto max-w-3xl">
      <a
        href="/ideas/"
        class="inline-flex items-center gap-1.5 text-[14px] text-steel transition-colors hover:text-obsidian"
      >
        <span aria-hidden="true">←</span> All thoughts
      </a>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3 text-[13px]">
          <span class="tag">{thought.category}</span>
          <time datetime={thought.pub_date} class="text-fog">
            {formatDate(new Date(thought.pub_date))}
          </time>
          <span class="text-mist" aria-hidden="true">·</span>
          <span class="text-fog">{minutes} min read</span>
        </div>
        <LikeButton client:visible slug={thought.slug} showLabel />
      </div>

      <h1 class="mt-5 text-[34px] font-semibold leading-[1.08] tracking-[-0.03em] text-obsidian sm:text-[52px]">
        {thought.title}
      </h1>
      {thought.description && (
        <p class="mt-5 text-[20px] leading-relaxed text-steel sm:text-[22px]">
          {thought.description}
        </p>
      )}

      <div class="mt-8 h-px w-full bg-cloud" aria-hidden="true"></div>

      <div class="prose mt-10 max-w-none">
        {
          blocks.map((b, i) => {
            if (b.type === 'h') {
              return (
                <h2 class="flex items-center gap-3">
                  <span class="h-px w-8 shrink-0 bg-ember" aria-hidden="true"></span>
                  {b.text}
                </h2>
              );
            }
            if (b.type === 'quote') {
              return <blockquote>{b.text}</blockquote>;
            }
            if (b.type === 'ul') {
              return (
                <div>
                  {b.intro && <p>{b.intro}</p>}
                  <ul class="not-prose mt-5 flex flex-col gap-4">
                    {b.items.map((it) => (
                      <li class="flex gap-4 text-[18px] leading-relaxed text-graphite">
                        <span class="mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-ember" aria-hidden="true"></span>
                        <span>{it}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            }
            return (
              <p
                class:list={[
                  i === firstPara &&
                    'text-[20px] leading-relaxed text-obsidian first-letter:mr-3 first-letter:float-left first-letter:text-[56px] first-letter:font-semibold first-letter:leading-[0.78] first-letter:text-ember',
                ]}
              >
                {b.text}
              </p>
            );
          })
        }
      </div>
    </div>
  </Container>
</BaseLayout>
